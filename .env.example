# ==========================================
# AETHER SERVERLESS EDITORIAL BLOG - ENV VARS
# ==========================================

# Database: Neon Serverless Postgres (HTTP Driver)
# Example: postgres://user:pass@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgres://placeholder:placeholder@localhost:5432/placeholder"

# Rate Limiting: Upstash Redis REST API
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token"

# Deployment Domain
NEXT_PUBLIC_SITE_URL="https://serverlessblogapp.vercel.app"

# Auth.js Admin Secret
AUTH_SECRET="super-secret-random-32-character-string"
